generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTHENTICATION ────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── USERS ─────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(VIEWER)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  payments            Payment[]
  pantryItems         PantryItem[]
  personalCategories  PersonalCategory[]
  personalPayments    PersonalPayment[]
  personalCards       PersonalCard[]
  bankAccounts        BankAccount[]
  financialSnapshots  FinancialSnapshot[]
}

// ─── CATEGORIES ────────────────────────────────────────────────────────────────

enum CategoryType {
  PAYMENT
  PANTRY
  BOTH
}

model Category {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  color       String       @default("#6366f1")
  icon        String?
  type        CategoryType @default(BOTH)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payments    Payment[]
  pantryItems PantryItem[]
}

// ─── PAYMENTS ──────────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  CHECK
  OTHER
}

enum Period {
  ONCE
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

model Payment {
  id            String        @id @default(cuid())
  folio         String        @unique
  name          String
  concept       String
  amount        Decimal       @db.Decimal(12, 2)
  paymentDate   DateTime?
  dueDate       DateTime?
  period        Period        @default(MONTHLY)
  status        PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(CASH)
  receipt       String?
  comments      String?       @db.Text
  registeredAt  DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  paidById String?
  paidBy   User?    @relation(fields: [paidById], references: [id])

  personalCardId String?
  card           PersonalCard? @relation("SharedPaymentCard", fields: [personalCardId], references: [id], onDelete: SetNull)

  bankTransactionId String?         @unique
  sourceStatementId String?
  importedFromBank  Boolean         @default(false)

  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)

  @@index([registeredAt])
  @@index([paymentDate])
  @@index([status])
  @@index([categoryId])
}

// ─── PANTRY ────────────────────────────────────────────────────────────────────

enum PantryUnit {
  PCS
  KG
  G
  L
  ML
  PKG
  BOX
  CAN
  BOTTLE
  DOZEN
}

model PantryItem {
  id           String     @id @default(cuid())
  name         String
  quantity     Decimal    @db.Decimal(10, 3)
  unit         PantryUnit @default(PCS)
  minStock     Decimal    @db.Decimal(10, 3) @default(1)
  price        Decimal?   @db.Decimal(10, 2)
  purchaseDate DateTime? @db.Date
  expiryDate   DateTime? @db.Date
  comments     String?    @db.Text
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  addedById String?
  addedBy   User?    @relation(fields: [addedById], references: [id])

  purchaseHistory PantryPurchaseHistory[]
}

model PantryPurchaseHistory {
  id                   String    @id @default(cuid())
  pantryItemId         String
  purchaseDate         DateTime  @db.Date
  previousPurchaseDate DateTime? @db.Date
  daysElapsed          Int?
  price                Decimal?  @db.Decimal(10, 2)
  notes                String?   @db.Text
  createdAt            DateTime  @default(now())

  item PantryItem @relation(fields: [pantryItemId], references: [id], onDelete: Cascade)

  @@index([pantryItemId])
}

// ─── PERSONAL FINANCES ─────────────────────────────────────────────────────────

enum FinancialClass {
  INCOME
  EXPENSE
  TRANSFER
  SAVING
}

model PersonalCategory {
  id          String       @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String       @default("#6366f1")
  icon        String?
  type        CategoryType @default(PAYMENT)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments PersonalPayment[]

  @@unique([userId, name])
  @@index([userId])
}

model PersonalPayment {
  id             String        @id @default(cuid())
  userId         String
  folio          String        @unique
  name           String
  concept        String
  amount         Decimal       @db.Decimal(12, 2)
  categoryId     String
  personalCardId String?
  period         Period        @default(MONTHLY)
  status         PaymentStatus @default(PENDING)
  paymentMethod  PaymentMethod @default(CASH)
  dueDate        DateTime?
  paymentDate    DateTime?
  notes          String?        @db.Text
  receipt        String?
  type              String?
  financialClass    FinancialClass?
  bankTransactionId String?         @unique
  sourceStatementId String?
  importedFromBank  Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        PersonalCategory  @relation(fields: [categoryId], references: [id])
  card            PersonalCard?     @relation(fields: [personalCardId], references: [id])
  bankTransaction BankTransaction?  @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, paymentDate])
  @@index([userId, createdAt])
}

// ─── PERSONAL CARDS ────────────────────────────────────────────────────────────

enum PaymentSourceType {
  CREDIT_CARD
  DEBIT_CARD
  BANK_ACCOUNT
}

model PersonalCard {
  id                String            @id @default(cuid())
  userId            String
  bankName          String
  cardName          String
  last4Digits       String
  paymentSourceType PaymentSourceType @default(CREDIT_CARD)
  closingDay        Int               @default(0)
  dueDay            Int               @default(0)
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       PersonalPayment[]
  sharedPayments Payment[]         @relation("SharedPaymentCard")

  @@unique([userId, bankName, last4Digits, paymentSourceType])
  @@index([userId])
}

// ─── FINANCIAL SNAPSHOTS ───────────────────────────────────────────────────────

model FinancialSnapshot {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @db.Date
  score           Int?
  scoreLabel      String?
  financialStatus String
  overdueTotal    Decimal  @db.Decimal(14, 2)
  pendingTotal    Decimal  @db.Decimal(14, 2)
  freeCashflow    Decimal? @db.Decimal(14, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// ─── FINANCIAL DATA ────────────────────────────────────────────────────────────

enum AccountType {
  CHECKING
  CREDIT
}

enum BankAccountScope {
  PERSONAL
  HOUSEHOLD
}

model BankAccount {
  id            String           @id @default(cuid())
  userId        String
  bankName      String
  productName   String
  accountNumber String?
  clabe         String?
  cardNumber    String?
  currency      String           @default("MXN")
  type          AccountType
  scope         BankAccountScope @default(PERSONAL)
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  statements   BankStatement[]
  transactions BankTransaction[]

  @@unique([userId, bankName, productName, cardNumber])
  @@index([userId])
  @@index([scope])
}

model BankStatement {
  id             String    @id @default(cuid())
  accountId      String
  periodStart    DateTime  @db.Date
  periodEnd      DateTime  @db.Date
  cutDate        DateTime? @db.Date
  openingBalance Decimal?  @db.Decimal(14, 2)
  closingBalance Decimal?  @db.Decimal(14, 2)
  totalCharges   Decimal?  @db.Decimal(14, 2)
  totalCredits   Decimal?  @db.Decimal(14, 2)
  sourceFile     String?
  importedAt     DateTime  @default(now())

  account      BankAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([accountId, periodStart, periodEnd])
  @@index([accountId])
}

model BankTransaction {
  id              String   @id @default(cuid())
  statementId     String
  accountId       String
  transactionDate DateTime @db.Date
  description     String
  reference       String?
  chargeAmount    Decimal? @db.Decimal(14, 2)
  creditAmount    Decimal? @db.Decimal(14, 2)
  balance         Decimal? @db.Decimal(14, 2)
  category        String?
  rawOcrText      String?  @db.Text
  txnHash         String?
  createdAt       DateTime @default(now())

  statement       BankStatement    @relation(fields: [statementId], references: [id], onDelete: Cascade)
  account         BankAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  personalPayment PersonalPayment?
  payment         Payment?

  @@unique([statementId, txnHash])
  @@index([accountId])
  @@index([statementId])
  @@index([transactionDate])
}
